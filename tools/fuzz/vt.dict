#
# libFuzzer dictionary for afterglow_vtfuzz (-dict=tools/fuzz/vt.dict): the
# introducers and protocol keywords that random mutation rarely reaches. The
# colour values also help afterglow_protofuzz reach the specs of its target 9.

# Introducers and terminators
"\x1b["
"\x1b]"
"\x1bP"
"\x1b_"
"\x1b\\"
"\x07"
"\x1b[?"
"\x1b[>"
"\x1b[<"
"\x1b[="
"\x1b#"
"\x1b("
"\xff"

# A state frame record (op 11 with bit 4, a 21 by 9 replica), then the codec
# version and a reset section of the primary screen
"\xff\x1b\x14\x08\x01"
"\x01\x04"

# CSI parameters
";"
":"
"4096"
"65535"
" q"
"$p"
"$v"
"$r"
"*y"
"#P"
"#Q"

# Kitty graphics (APC G)
"G"
"a=T"
"a=t"
"a=p"
"a=d"
"a=f"
"a=a"
"a=q"
"a=c"
"f=8"
"f=16"
"f=24"
"f=32"
"f=100"
"t=d"
"o=z"
"s="
"v="
"i="
"p="
"P="
"Q="
"U=1"
"m=1"

# OSC numbers and keys
"0;"
"4;"
"7;file://"
"8;id="
"9;4;"
"9;9;"
"21;"
"22;"
"52;c;"
"66;s=2;"
"66;w=2;"
"66;n=1:d=2;"
"99;"
"133;A"
"133;B"
"133;C"
"133;D;0"
"133;C;cmdline="
"133;C;cmdline_url="
"633;E;"
"1337;File="
"1337;MultipartFile="
"1337;FilePart="
"1337;FileEnd"
"1337;SetUserVar="
"3008;start="
"5522;type="
"7501;"
"24569;q=remote"
"24569;path=/"
"24569;error=off"
"24569;error=forward"

# DCS bodies
"q#0;2;100;0;0"
"+q544E"
"$qm"

# Colour values (OSC 4, 10-12, 17, 19 and 21)
"oklch(0.7 0.1 200)"
"lab(50 60 40)"
"oklch("
"lab("
"rgb:"
"rgbi:"
"none"
"deg"
