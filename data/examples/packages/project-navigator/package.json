{
  "id": "project-navigator",
  "version": "1.0.0",
  "api_version": 1,
  "state_version": 2,
  "entry": "main",
  "modules": {
    "main": "init.luau",
    "providers": "providers.luau",
    "history": "history.luau"
  },
  "config": {
    "roots": ["~/Projects"],
    "fd": true,
    "zoxide": true,
    "max_depth": 5
  },
  "commands": {
    "open": {"summary": "Open a project directory, with a saved layout", "usage": "DIR [LAYOUT]"},
    "list": {"summary": "Print the favorite, recent and saved projects"},
    "pick": {"summary": "Choose a project in a picker", "palette": "Navigate projects"},
    "favorite": {"summary": "Pin or unpin the pane's project directory", "palette": "Toggle favorite project directory"},
    "previous": {"summary": "Open the previous project", "palette": "Previous project"}
  }
}
