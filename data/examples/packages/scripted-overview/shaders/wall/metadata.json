{
    "id": "scripted-overview.wall",
    "name": "Overview Wall",
    "category": "Overview",
    "description": "A pane overview in a grid on a gently curved wall. The highlighted card lifts toward you.",
    "author": "afterglow",
    "version": "1.0",
    "fragmentShader": "effect.frag",
    "parameters": [
        {"id": "curve", "name": "Wall curve", "group": "Wall", "type": "float", "default": 0.5, "min": 0.0, "max": 1.0},
        {"id": "lift", "name": "Highlight lift", "group": "Wall", "type": "float", "default": 0.1, "min": 0.0, "max": 0.3},
        {"id": "sideBrightness", "name": "Brightness of other cards", "group": "Wall", "type": "float", "default": 0.55, "min": 0.2, "max": 1.0},
        {"id": "backdropDim", "name": "Backdrop dimming", "group": "Backdrop", "type": "float", "default": 0.75, "min": 0.0, "max": 1.0},
        {"id": "blur", "name": "Backdrop blur", "group": "Backdrop", "type": "float", "default": 24.0, "min": 0.0, "max": 48.0, "unit": "px"}
    ]
