{
  "id": "tab-status",
  "version": "1.0.0",
  "api_version": 1,
  "state_version": 1,
  "entry": "main",
  "modules": {
    "main": "init.luau",
    "segments": "segments.luau"
  },
  "config": {
    "segments": [
      "command",
      "exit",
      "git",
      "cwd",
      "context"
    ],
    "powerline": true,
    "tab_max_length": 24,
    "git": true,
    "git_changes": false,
    "git_refresh_seconds": 15
  }
}
