#
# Zsh completion for afterglow. Script IDs and their commands come from the
# running afterglow (afterglow run --complete).

_afterglow_run() {
    local -a ids commands
    # Options only before the script ID. --help only alone: after an option
    # it would name a script.
    _arguments -s -S -A '-*' \
        '(- *)'{-h,--help}'[show the usage]' \
        '(-h --help -n --no-stdin)'{-n,--no-stdin}'[do not pass standard input to the command]' \
        '(-h --help)--pane[the pane that the command acts on]:pane ID:' \
        '1:script:->id' \
        '2:command:->command' \
        '*::argument:->argument' && return
    case $state in
    id)
        ids=(${(f)"$("$self" run --complete 2>/dev/null)"})
        _describe -t ids 'script' ids
        ;;
    command)
        # COMMAND<TAB>SUMMARY lines, as name:description pairs.
        commands=(${${(f)"$("$self" run --complete "${line[1]}" 2>/dev/null)"}/$'\t'/:})
        commands+=('--help:list the script'"'"'s commands')
        _describe -t commands 'command' commands
        ;;
    argument)
        # The command's own arguments: files, most likely. ID --help takes none.
        [[ $line[2] == (-h|--help) ]] || _files
        ;;
    esac
}

# The keybind actions that ctl action runs (afterglow/src/config/Keybinds.cpp),
# and the script commands that it starts, as script:ID.COMMAND.
_afterglow_actions() {
    local id entry ret=1
    local -a keybinds actions
    keybinds=(
        'swap_left:swap pane left'
        'swap_right:swap pane right'
        'swap_up:swap pane above'
        'swap_down:swap pane below'
        'rotate_panes_clockwise:rotate panes clockwise'
        'rotate_panes_counterclockwise:rotate panes counterclockwise'
        'pane_overview:pane overview'
        'use_package_shaders:use package shaders'
        'move_pane_to_tab:move pane to new tab'
        'move_pane_to_window:move pane to new window'
        'detach_tab:detach tab to new window'
        'save_project:save project'
        'switch_project:switch project'
        'end_script_key_mode:end script key mode'
        'split_right:split right'
        'split_down:split down'
        'split_left:split left'
        'split_up:split up'
        'rename_pane:change pane title'
        'close_pane:close pane'
        'new_window:new window'
        'new_tab:new tab'
        'close_tab:close tab'
        'rename_tab:change tab title'
        'move_tab_left:move tab left'
        'move_tab_right:move tab right'
        'goto_tab_1:go to tab 1'
        'goto_tab_2:go to tab 2'
        'goto_tab_3:go to tab 3'
        'goto_tab_4:go to tab 4'
        'goto_tab_5:go to tab 5'
        'goto_tab_6:go to tab 6'
        'goto_tab_7:go to tab 7'
        'goto_tab_8:go to tab 8'
        'goto_tab_9:go to the last tab'
        'close_window:close window'
        'toggle_fullscreen:toggle fullscreen'
        'next_tab:next tab'
        'previous_tab:previous tab'
        'show_hints:select text or file reference'
        'show_last_output:view last command output in pager'
        'copy_mode:keyboard copy mode'
        'copy:copy'
        'paste:paste'
        'select_all:select all'
        'clear_screen:clear screen and scrollback'
        'reset:reset terminal'
        'notify_on_finish:notify when the next command finishes'
        'focus_left:focus pane left'
        'focus_right:focus pane right'
        'focus_up:focus pane above'
        'focus_down:focus pane below'
        'equalize_splits:equalize splits'
        'toggle_pane_zoom:toggle pane zoom'
        'resize_left:resize pane left'
        'resize_right:resize pane right'
        'resize_up:resize pane up'
        'resize_down:resize pane down'
        'font_bigger:increase font size'
        'font_smaller:decrease font size'
        'font_reset:reset font size'
        'scroll_page_up:scroll page up'
        'scroll_page_down:scroll page down'
        'scroll_top:scroll to top'
        'scroll_bottom:scroll to bottom'
        'jump_prompt_up:jump to previous prompt'
        'jump_prompt_down:jump to next prompt'
        'search:search'
        'command_palette:command palette'
        'reload_config:reload config'
        'open_config:open config file'
        'show_urls_open:open a url on screen'
        'show_urls_copy:copy a url on screen'
        'unicode_input:insert unicode character'
    )
    _describe -t keybinds 'keybind action' keybinds && ret=0
    for id in ${(f)"$("$self" run --complete 2>/dev/null)"}; do
        for entry in ${(f)"$("$self" run --complete "$id" 2>/dev/null)"}; do
            actions+=("script\\:$id.${entry%%$'\t'*}:${entry#*$'\t'}")
        done
    done
    _describe -t actions 'script command' actions && ret=0
    return ret
}

_afterglow_ctl() {
    local -a commands help
    commands=(
        'ls:list panes'
        'send-text:type text into the pane'
        'get-text:print pane text'
        'split:split the pane'
        'move-pane:move the pane beside another'
        'detach-tab:move the pane'"'"'s tab to a new window'
        'new-tab:open a tab'
        'new-window:open a window'
        'focus:focus the pane'
        'close:close the pane'
        'set-title:set the pane'"'"'s title'
        'signal:set a shader signal'
        'notify:show a desktop notification'
        'scripts:show script diagnostics'
        'open-directory:open a directory'
        'projects:list saved projects'
        'save-project:save the window layout'
        'open-project:open a saved project'
        'action:run a keybind action or start a script command'
        'watch:print events'
    )
    if (( CURRENT == 2 )); then
        if [[ $PREFIX == -* ]]; then
            help=('-h:show the usage' '--help:show the usage')
            _describe -t options 'option' help
        else
            _describe -t commands 'ctl command' commands
        fi
        return
    fi
    # From here, words[1] is the ctl command.
    shift words; (( CURRENT-- ))
    local pane='--pane[the pane]:pane ID:'
    case $words[1] in
    split|new-tab|new-window)
        # A command to run follows "--", and only options come before it.
        local dash=${words[(i)--]}
        if (( dash < CURRENT )); then
            shift $dash words; (( CURRENT -= dash ))
            _normal
            return
        fi
        ;;
    esac
    case $words[1] in
    ls) _arguments '--json[print JSON]' ;;
    send-text)
        _arguments -S $pane '(--stdin)--raw[send the text as it is]' '(--raw *)--stdin[send standard input]' \
            '(--stdin)*:text:' ;;
    get-text)
        _arguments $pane \
            '(--screen --scrollback --selection --last-output)'{--screen,--scrollback,--selection,--last-output} ;;
    split) _arguments $pane '(--left --right --up --down)'{--left,--right,--up,--down} ;;
    move-pane)
        _arguments $pane '1:target pane ID (0 for new-tab and new-window):' \
            '2:placement:(left right up down new-tab new-window)' ;;
    new-tab) _arguments $pane '--cwd[working directory]:directory:_directories' ;;
    new-window) _arguments '--cwd[working directory]:directory:_directories' ;;
    set-title) _arguments -S $pane '*:title:' ;;
    signal) _arguments $pane '1:channel:(0 1 2 3 4 5 6 7)' '2:value:' ;;
    notify) _arguments -S $pane '1:title:' '*:body:' ;;
    open-directory) _arguments '--layout[a saved layout]:layout:' '1:directory:_directories' ;;
    save-project) _arguments $pane '--overwrite[replace a project with the name]' '1:name:' ;;
    open-project) _arguments '--new[launch the layout again]' '1:name:' ;;
    action) _arguments $pane '1:action:_afterglow_actions' ;;
    watch|scripts|projects) ;;
    *) _arguments $pane ;;
    esac
}

_afterglow() {
    local curcontext=$curcontext state state_descr line
    typeset -A opt_args
    # The afterglow that is being completed, which need not be the one on PATH. The word is as typed: (Q) removes
    # its quotes.
    local self=${(Q)words[1]}
    [[ $self == '~/'* ]] && self=$HOME/${self#'~/'}
    local -a subcommands
    subcommands=(
        'ctl:drive a running afterglow'
        'run:run a command of a script'
        'ssh:ssh with the remote side prepared'
        'transfer:copy files to and from the computer of the terminal'
        'dnd:drag files and data out of the terminal, and drop them in'
        'icat:show images in the terminal'
        'clipboard:read and write the clipboard, with any MIME type'
    )
    # A subcommand only comes first, and the word at the cursor is not one yet.
    if (( CURRENT > 2 )); then
        case $words[2] in
        ctl)
            shift words; (( CURRENT-- ))
            _afterglow_ctl
            return
            ;;
        run)
            shift words; (( CURRENT-- ))
            _afterglow_run
            return
            ;;
        ssh)
            # The rest is ssh's command line.
            shift words; (( CURRENT-- ))
            _normal
            return
            ;;
        transfer|dnd|icat|clipboard)
            # These run aglow, whose completion reads its command at the same
            # position. Without it, the arguments are files, most likely.
            if (( $+functions[_aglow] )); then
                _aglow
            else
                _files
            fi
            return
            ;;
        esac
    elif [[ $PREFIX != -* ]]; then
        _describe -t subcommands 'subcommand' subcommands
        return
    fi
    # --quick-terminal takes no -e, -d, --title or --hold. Each of the last
    # options is the whole command line, so it comes only first, and nothing
    # follows it.
    local word
    for word in $words[2,CURRENT-1]; do
        # The program of -e has options of its own.
        [[ $word == (-e|--execute) ]] && break
        [[ $word == (--config-reference|-h|--help|--help-all|-v|--version) ]] && return 1
    done
    local -a alone
    (( CURRENT == 2 )) && alone=(
        '(- *)--config-reference[print the configuration reference as JSON]'
        '(- *)'{-h,--help}'[show the help]'
        '(- *)--help-all[show the help, with the options of Qt]'
        '(- *)'{-v,--version}'[show the version]'
    )
    _arguments -s -S \
        '(-d --working-directory --quick-terminal)'{-d+,--working-directory=}'[start in the directory]:directory:_directories' \
        '(-e --execute --quick-terminal)'{-e,--execute}'[run the rest of the command line instead of the shell]:*::command:_normal' \
        '(--quick-terminal)--title=[give the window a title]:title:' \
        '(--quick-terminal)--hold[keep the window open after the program exits]' \
        '(-d --working-directory -e --execute --title --hold)--quick-terminal[show or hide the quick terminal]' \
        '--config=[read settings from the file]:config file:_files' \
        '*'{-o+,--override=}'[override a setting (Group.key=value)]:setting:' \
        '--class=[Wayland app id for window rules]:app id:' \
        $alone
}

_afterglow "$@"
