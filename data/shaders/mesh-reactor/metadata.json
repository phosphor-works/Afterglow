{
  "id": "mesh-reactor",
  "name": "Mesh Reactor",
  "description": "Instanced triangle meshes with hardware depth testing, metal lighting and audio response.",
  "fragmentShader": "effect.frag",
  "multipass": true,
  "bufferShaders": ["surface.frag"],
  "geometryPasses": [{"vertexShader": "scene.vert", "vertexCount": 18432, "instances": 4}],
  "halfFloatBuffers": true,
  "parameters": [
    {"id": "exposure", "name": "Exposure", "type": "float", "default": 1.0, "min": 0, "max": 3},
    {"id": "speed", "name": "Scene speed", "type": "float", "default": 0.4, "min": 0, "max": 2},
    {"id": "audio", "name": "Audio response", "type": "float", "default": 1.0, "min": 0, "max": 2}
  ]
}
