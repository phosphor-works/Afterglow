{
    "id": "pane-deck",
    "name": "Pane Deck",
    "category": "Overview",
    "description": "In the pane overview, the panes of every tab leave the window as live cards on a carousel, reflected in a glossy floor. The highlighted card turns to the front.",
    "author": "afterglow",
    "version": "1.0",
    "fragmentShader": "effect.frag",
    "parameters": [
        {"id": "cardSize", "name": "Card height (share of the window)", "group": "Deck", "type": "float", "default": 0.56, "min": 0.3, "max": 0.8},
        {"id": "spacing", "name": "Card spacing", "group": "Deck", "type": "float", "default": 1.12, "min": 0.9, "max": 2.0},
        {"id": "elevation", "name": "Camera height", "group": "Deck", "type": "float", "default": 0.2, "min": 0.0, "max": 0.5},
        {"id": "tabGap", "name": "Gap between tabs (cards)", "group": "Deck", "type": "float", "default": 0.6, "min": 0.0, "max": 2.0},
        {"id": "sideBrightness", "name": "Brightness of other cards", "group": "Deck", "type": "float", "default": 0.62, "min": 0.2, "max": 1.0},
        {"id": "reflection", "name": "Floor reflection", "group": "Backdrop", "type": "float", "default": 0.3, "min": 0.0, "max": 1.0},
        {"id": "backdropDim", "name": "Backdrop dimming", "group": "Backdrop", "type": "float", "default": 0.72, "min": 0.0, "max": 1.0},
        {"id": "blur", "name": "Backdrop blur", "group": "Backdrop", "type": "float", "default": 24.0, "min": 0.0, "max": 48.0, "unit": "px"}
    ],
    "presets": {
        "Flat": {"elevation": 0.0, "reflection": 0.0},
        "Showcase": {"elevation": 0.32, "reflection": 0.5, "backdropDim": 0.8}
    }
}
