{
    "id": "phosphor-panes",
    "name": "Phosphor Panes",
    "category": "Transition",
    "description": "A new pane fades in where it opens, and a closed pane fades out. The rim of the pane carries the Phosphor spectrum: it is bright at once and then fades. A pane whose shell moves to another host, user or container keeps a thin line at its edge in the color of that place.",
    "author": "afterglow",
    "version": "1.0",
    "fragmentShader": "effect.frag",
    "parameters": [
        {"id": "fade", "name": "Fade (part of the time)", "group": "Panes", "type": "float", "default": 0.5, "min": 0.05, "max": 1.0},
        {"id": "rim", "name": "Rim line", "group": "Rim", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0},
        {"id": "rimWidth", "name": "Rim line width", "group": "Rim", "type": "float", "default": 2.0, "min": 0.5, "max": 8.0, "unit": "px"},
        {"id": "glow", "name": "Rim glow", "group": "Rim", "type": "float", "default": 0.6, "min": 0.0, "max": 2.0},
        {"id": "reach", "name": "Rim glow reach", "group": "Rim", "type": "float", "default": 28.0, "min": 4.0, "max": 200.0, "unit": "px"},

        {"id": "mark", "name": "Line while a pane is away from here", "group": "Context", "type": "float", "default": 0.8, "min": 0.0, "max": 1.0},

        {"id": "followTheme", "name": "Follow terminal palette", "group": "Colors", "type": "bool", "default": false},
        {"id": "stop0", "name": "Gradient start, and a remote host", "group": "Colors", "type": "color", "default": "#22D3EE"},
        {"id": "stop1", "name": "Gradient second", "group": "Colors", "type": "color", "default": "#3B82F6"},
        {"id": "stop2", "name": "Gradient third, and a container", "group": "Colors", "type": "color", "default": "#A855F7"},
        {"id": "stop3", "name": "Gradient end, and an elevated user", "group": "Colors", "type": "color", "default": "#F43F5E"}
    ],
    "presets": {
        "Quiet": {"glow": 0.0, "mark": 0.45},
        "Bright": {"glow": 1.2, "mark": 1.0}
    }
}
