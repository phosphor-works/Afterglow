{
    "id": "phosphor-tabs",
    "name": "Phosphor Tabs",
    "category": "Transition",
    "description": "When you switch tabs, the new tab slides in over the tab being left, which falls behind and dims. A line of the Phosphor spectrum runs down the edge between them and fades as the new tab arrives. The fade style blends the two tabs with no motion.",
    "author": "afterglow",
    "version": "1.0",
    "fragmentShader": "effect.frag",
    "parameters": [
        {"id": "style", "name": "Style (0 slide, 1 fade)", "group": "Switch", "type": "int", "default": 0, "min": 0, "max": 1},
        {"id": "parallax", "name": "Travel of the tab being left", "group": "Switch", "type": "float", "default": 0.3, "min": 0.0, "max": 1.0},
        {"id": "dim", "name": "Dimming of the tab being left", "group": "Switch", "type": "float", "default": 0.5, "min": 0.0, "max": 1.0},

        {"id": "seam", "name": "Edge line", "group": "Edge", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0},
        {"id": "seamWidth", "name": "Edge line width", "group": "Edge", "type": "float", "default": 2.0, "min": 0.5, "max": 8.0, "unit": "px"},
        {"id": "glow", "name": "Edge glow", "group": "Edge", "type": "float", "default": 0.6, "min": 0.0, "max": 2.0},
        {"id": "reach", "name": "Edge glow reach", "group": "Edge", "type": "float", "default": 40.0, "min": 4.0, "max": 200.0, "unit": "px"},

        {"id": "followTheme", "name": "Follow terminal palette", "group": "Colors", "type": "bool", "default": false},
        {"id": "stop0", "name": "Gradient start", "group": "Colors", "type": "color", "default": "#22D3EE"},
        {"id": "stop1", "name": "Gradient second", "group": "Colors", "type": "color", "default": "#3B82F6"},
        {"id": "stop2", "name": "Gradient third", "group": "Colors", "type": "color", "default": "#A855F7"},
        {"id": "stop3", "name": "Gradient end", "group": "Colors", "type": "color", "default": "#F43F5E"}
    ],
    "presets": {
        "Slide": {"style": 0},
        "Fade": {"style": 1}
    }
}
