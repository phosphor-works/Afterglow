{
  "id": "feedback-glow",
  "name": "Feedback Glow",
  "category": "Pane",
  "description": "A bounded linear-light afterimage of bright terminal pixels.",
  "author": "afterglow",
  "version": "1.0",
  "fragmentShader": "effect.frag",
  "multipass": true,
  "bufferShaders": ["buffer.frag"],
  "bufferFeedback": true,
  "bufferScale": 0.5,
  "halfFloatBuffers": true,
  "bufferWrap": "clamp",
  "bufferFilter": "linear",
  "parameters": [
    {"id":"decay","name":"Decay per second","type":"float","default":4.0,"min":0.5,"max":12.0,"slot":0},
    {"id":"strength","name":"Intensity","type":"float","default":0.15,"min":0.0,"max":0.5,"slot":1}
  ],
  "presets":{"Subtle":{"decay":5.0,"strength":0.1},"Lingering":{"decay":1.5,"strength":0.25}}
}
