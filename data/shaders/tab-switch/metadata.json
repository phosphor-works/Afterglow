{
    "id": "tab-switch",
    "name": "Tab Switch",
    "category": "Transition",
    "description": "Animates switching tabs: a turning cube, a page flip, a shatter or a slide. The tab being left keeps running until the new one has arrived.",
    "author": "afterglow",
    "version": "1.0",
    "fragmentShader": "effect.frag",
    "parameters": [
        {"id": "style", "name": "Style (0 cube, 1 page flip, 2 shatter, 3 slide)", "group": "Switch", "type": "int", "default": 0, "min": 0, "max": 3},
        {"id": "depth", "name": "Camera pull-back", "group": "Switch", "type": "float", "default": 0.35, "min": 0.0, "max": 1.0},
        {"id": "shading", "name": "Shading", "group": "Switch", "type": "float", "default": 0.6, "min": 0.0, "max": 1.0}
    ],
    "presets": {
        "Cube": {"style": 0},
        "Page flip": {"style": 1},
        "Shatter": {"style": 2},
        "Slide": {"style": 3}
    }
}
