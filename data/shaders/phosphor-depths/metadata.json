{
    "id": "phosphor-depths",
    "name": "Phosphor Depths",
    "category": "Background",
    "description": "The terminal floats over a deep, dark luminous volume: slow clouds of the phosphor gradient drift far below, dust hangs in the glass, and the cursor carries a breathing ember that leaves a wake when it jumps. Nothing glows under text. Use it as a window shader.",
    "author": "afterglow",
    "version": "1.0",
    "fragmentShader": "effect.frag",
    "parameters": [
        { "id": "depthIntensity", "name": "Glow Intensity", "group": "Depths", "type": "float", "default": 0.085, "min": 0.0, "max": 0.4 },
        { "id": "filamentGain", "name": "Filaments", "group": "Depths", "type": "float", "default": 0.8, "min": 0.0, "max": 3.0 },
        { "id": "depthScale", "name": "Cloud Scale", "group": "Depths", "type": "float", "default": 1.9, "min": 0.3, "max": 8.0 },
        { "id": "driftSpeed", "name": "Drift Speed", "group": "Depths", "type": "float", "default": 1.0, "min": 0.0, "max": 20.0 },

        { "id": "dustIntensity", "name": "Dust Intensity", "group": "Dust", "type": "float", "default": 0.12, "min": 0.0, "max": 1.0 },
        { "id": "dustDensity", "name": "Dust Density", "group": "Dust", "type": "float", "default": 42.0, "min": 4.0, "max": 160.0 },
        { "id": "dustSpeed", "name": "Dust Speed", "group": "Dust", "type": "float", "default": 12.0, "min": 0.0, "max": 40.0 },
        { "id": "dustSway", "name": "Dust Sway", "group": "Dust", "type": "float", "default": 0.10, "min": 0.0, "max": 0.12 },
        { "id": "dustTextFloor", "name": "Dust Over Busy Screens", "group": "Dust", "type": "float", "default": 0.0, "min": 0.0, "max": 1.0 },

        { "id": "textClearance", "name": "Text Clearance (cells)", "group": "Text", "type": "float", "default": 0.72, "min": 0.0, "max": 3.0 },

        { "id": "emberIntensity", "name": "Ember Intensity", "group": "Cursor", "type": "float", "default": 0.85, "min": 0.0, "max": 3.0 },
        { "id": "emberRadius", "name": "Ember Radius (cells)", "group": "Cursor", "type": "float", "default": 1.22, "min": 0.1, "max": 6.0 },
        { "id": "emberTint", "name": "Cursor Colour Tint", "group": "Cursor", "type": "float", "default": 0.0, "min": 0.0, "max": 1.0 },
        { "id": "wakeDuration", "name": "Wake Duration (seconds)", "group": "Cursor", "type": "float", "default": 0.45, "min": 0.05, "max": 3.0 },
        { "id": "wakeWidth", "name": "Wake Width (cells)", "group": "Cursor", "type": "float", "default": 0.39, "min": 0.05, "max": 3.0 },
        { "id": "wakeMinDistance", "name": "Wake Minimum Jump (cells)", "group": "Cursor", "type": "float", "default": 0.0, "min": 0.0, "max": 20.0 },
        { "id": "emberSleeps", "name": "Ember Sleeps When Unfocused", "group": "Cursor", "type": "bool", "default": true },

        { "id": "followTheme", "name": "Follow Terminal Palette", "group": "Colours", "type": "bool", "default": false },
        { "id": "stop0", "name": "Gradient Start", "group": "Colours", "type": "color", "default": "#22D3EE" },
        { "id": "stop1", "name": "Gradient Second", "group": "Colours", "type": "color", "default": "#3B82F6" },
        { "id": "stop2", "name": "Gradient Third", "group": "Colours", "type": "color", "default": "#A855F7" },
        { "id": "stop3", "name": "Gradient End", "group": "Colours", "type": "color", "default": "#F43F5E" }
    ]
}
