<component type="desktop-application">
  <id>io.github.fuddlesworth.Afterglow</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Afterglow</name>
  <summary>A GPU-accelerated terminal for Wayland</summary>
  <developer id="io.github.fuddlesworth">
    <name>fuddlesworth</name>
  </developer>
  <description>
    <p>
      Afterglow is a terminal built on Qt and Vulkan. Every pane of every
      window draws through one GPU device, with splits, tabs and a drop-down
      quick terminal.
    </p>
    <ul>
      <li>Kitty keyboard, graphics, text sizing, notification and clipboard protocols, and sixel images</li>
      <li>Full Monaspace support: texture healing, ligatures and variable axes</li>
      <li>Custom shaders per pane and per window, animated splits, smooth scrolling and cursor motion</li>
      <li>Program status, shell integration, hyperlinks and keyboard-driven URL opening</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/phosphor-works/afterglow</url>
  <url type="bugtracker">https://github.com/phosphor-works/afterglow/issues</url>
  <url type="vcs-browser">https://github.com/phosphor-works/afterglow</url>
  <launchable type="desktop-id">io.github.fuddlesworth.Afterglow.desktop</launchable>
  <provides>
    <binary>afterglow</binary>
  </provides>
  <categories>
    <category>System</category>
    <category>TerminalEmulator</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-10-29"/>
  </releases>
</component>
