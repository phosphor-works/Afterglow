[Desktop Entry]
Type=Application
Name=Afterglow
GenericName=Terminal
Comment=A GPU-accelerated terminal for Wayland
Exec=afterglow
Icon=com.phosphorworks.Afterglow
Terminal=false
Categories=System;TerminalEmulator;Qt;
Keywords=shell;prompt;command;commandline;cmd;terminal;console;
StartupNotify=true
StartupWMClass=com.phosphorworks.Afterglow
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory
X-TerminalArgTitle=--title
X-TerminalArgAppId=--class
X-TerminalArgHold=--hold
Actions=new-window;quick-terminal;

[Desktop Action new-window]
Name=New Window
Exec=afterglow

[Desktop Action quick-terminal]
Name=Toggle Quick Terminal
Exec=afterglow --quick-terminal
