{
    "version": 3,
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Development (RelWithDebInfo)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "AFTERGLOW_BUILD_TOOLS": "ON" }
        },
        {
            "name": "debug",
            "displayName": "Debug with sanitizers (ASan and UBSan at -O1; GCC's maybe-uninitialized check misfires on instrumented code)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-O1 -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-maybe-uninitialized",
                "CMAKE_CXX_FLAGS": "-O1 -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-maybe-uninitialized"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "AFTERGLOW_BUILD_TOOLS": "ON" }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" },
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" }
    ],
    "testPresets": [
        { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
    ]
}
